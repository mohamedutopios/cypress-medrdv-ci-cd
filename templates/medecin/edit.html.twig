{% extends 'base.html.twig' %}
{% block title %}Modifier {{ medecin.nomComplet }}{% endblock %}
{% block body %}
<nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_medecin_index') }}">Médecins</a></li><li class="breadcrumb-item"><a href="{{ path('app_medecin_show', {id: medecin.id}) }}">{{ medecin.nomComplet }}</a></li><li class="breadcrumb-item active">Modifier</li></ol></nav>
<div class="row justify-content-center"><div class="col-lg-8"><div class="card">
    <div class="card-header py-3"><h4 class="mb-0"><i class="bi bi-pencil text-warning"></i> Modifier le médecin</h4></div>
    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="row"><div class="col-md-6 mb-3">{{ form_row(form.nom) }}</div><div class="col-md-6 mb-3">{{ form_row(form.prenom) }}</div></div>
        <div class="mb-3">{{ form_row(form.specialite) }}</div>
        <div class="row"><div class="col-md-6 mb-3">{{ form_row(form.email) }}</div><div class="col-md-6 mb-3">{{ form_row(form.telephone) }}</div></div>
        <div class="row"><div class="col-md-6 mb-3">{{ form_row(form.numeroOrdre) }}</div><div class="col-md-6 mb-3">{{ form_row(form.honoraires) }}</div></div>
        <div class="mb-3">{{ form_row(form.adresseCabinet) }}</div>
        <div class="d-flex justify-content-between"><a href="{{ path('app_medecin_show', {id: medecin.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a><button type="submit" class="btn btn-warning"><i class="bi bi-check-lg"></i> Enregistrer</button></div>
        {{ form_end(form) }}
    </div>
</div></div></div>
{% endblock %}
