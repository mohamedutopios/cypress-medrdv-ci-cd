{% extends 'base.html.twig' %}
{% block title %}{{ patient.nomComplet }}{% endblock %}
{% block body %}
<nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_patient_index') }}">Patients</a></li><li class="breadcrumb-item active">{{ patient.nomComplet }}</li></ol></nav>
<div class="row g-4">
    <div class="col-lg-4"><div class="card">
        <div class="card-body text-center py-4">
            <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px"><i class="bi bi-person-fill text-primary" style="font-size:2.5rem"></i></div>
            <h4>{{ patient.nomComplet }}</h4>
        </div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted"><i class="bi bi-envelope"></i> Email</span><a href="mailto:{{ patient.email }}">{{ patient.email }}</a></li>
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted"><i class="bi bi-telephone"></i> Tél</span><span>{{ patient.telephone }}</span></li>
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted"><i class="bi bi-calendar-heart"></i> Naissance</span><span>{{ patient.dateNaissance|date('d/m/Y') }}</span></li>
            {% if patient.numeroSecuriteSociale %}<li class="list-group-item d-flex justify-content-between"><span class="text-muted"><i class="bi bi-shield-check"></i> N° SS</span><span>{{ patient.numeroSecuriteSociale }}</span></li>{% endif %}
            {% if patient.adresse %}<li class="list-group-item"><span class="text-muted"><i class="bi bi-geo-alt"></i> Adresse</span><br>{{ patient.adresse }}</li>{% endif %}
        </ul>
        <div class="card-body d-flex gap-2">
            <a href="{{ path('app_patient_edit', {id: patient.id}) }}" class="btn btn-warning btn-sm flex-grow-1"><i class="bi bi-pencil"></i> Modifier</a>
            <form method="post" action="{{ path('app_patient_delete', {id: patient.id}) }}" onsubmit="return confirm('Supprimer ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ patient.id) }}"><button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button></form>
        </div>
    </div></div>
    <div class="col-lg-8"><div class="card">
        <div class="card-header d-flex justify-content-between align-items-center py-3"><h5 class="mb-0"><i class="bi bi-calendar-check text-primary"></i> Historique</h5><a href="{{ path('app_rendezvous_new') }}" class="btn btn-sm btn-primary"><i class="bi bi-plus"></i> Nouveau</a></div>
        <div class="card-body p-0">
            {% if rendez_vous|length > 0 %}
            <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Médecin</th><th>Motif</th><th>Durée</th><th>Statut</th><th></th></tr></thead><tbody>
            {% for rdv in rendez_vous %}
            <tr><td><strong>{{ rdv.dateHeure|date('d/m/Y H:i') }}</strong></td><td>{{ rdv.medecin.nomComplet }}</td><td>{{ (rdv.motif|default('-'))|slice(0,30) }}{{ (rdv.motif|default(''))|length > 30 ? '...' : '' }}</td><td>{{ rdv.dureeMinutes }} min</td><td><span class="badge {{ rdv.statutBadgeClass }}">{{ rdv.statutLabel }}</span></td><td><a href="{{ path('app_rendezvous_show', {id: rdv.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td></tr>
            {% endfor %}
            </tbody></table></div>
            {% else %}<div class="text-center py-4 text-muted">Aucun rendez-vous</div>{% endif %}
        </div>
    </div></div>
</div>
{% endblock %}
