{% extends 'base.html.twig' %}
{% block title %}Patients{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="mb-1">Patients</h2><p class="text-muted mb-0">{{ patients|length }} patient{{ patients|length > 1 ? 's' }}</p></div>
    <a href="{{ path('app_patient_new') }}" class="btn btn-primary"><i class="bi bi-person-plus"></i> Nouveau patient</a>
</div>
<div class="card mb-4"><div class="card-body py-3"><form method="get" class="row g-2 align-items-center"><div class="col-md-8"><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input type="text" name="q" class="form-control" placeholder="Rechercher..." value="{{ search }}"></div></div><div class="col-md-4 d-flex gap-2"><button type="submit" class="btn btn-primary flex-grow-1">Rechercher</button>{% if search %}<a href="{{ path('app_patient_index') }}" class="btn btn-outline-secondary">Effacer</a>{% endif %}</div></form></div></div>
<div class="card"><div class="card-body p-0">
{% if patients|length > 0 %}
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Nom</th><th>Email</th><th>Téléphone</th><th>Naissance</th><th>N° SS</th><th class="text-end">Actions</th></tr></thead><tbody>
{% for p in patients %}
<tr><td><a href="{{ path('app_patient_show', {id: p.id}) }}" class="text-decoration-none fw-semibold"><i class="bi bi-person-circle text-primary"></i> {{ p.nomComplet }}</a></td><td><a href="mailto:{{ p.email }}">{{ p.email }}</a></td><td>{{ p.telephone }}</td><td>{{ p.dateNaissance|date('d/m/Y') }}</td><td>{{ p.numeroSecuriteSociale|default('-') }}</td><td class="text-end"><div class="btn-group btn-group-sm"><a href="{{ path('app_patient_show', {id: p.id}) }}" class="btn btn-outline-primary"><i class="bi bi-eye"></i></a><a href="{{ path('app_patient_edit', {id: p.id}) }}" class="btn btn-outline-warning"><i class="bi bi-pencil"></i></a></div></td></tr>
{% endfor %}
</tbody></table></div>
{% else %}<div class="text-center py-5 text-muted"><i class="bi bi-people" style="font-size:3rem"></i><p class="mt-2">Aucun patient</p><a href="{{ path('app_patient_new') }}" class="btn btn-primary">Ajouter</a></div>{% endif %}
</div></div>
{% endblock %}
