<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MedRDV{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root{--sb:#1a2332}body{background:#f0f2f5;min-height:100vh}
        .sidebar{background:var(--sb);min-height:100vh;width:260px;position:fixed;top:0;left:0;z-index:1000}
        .sidebar .nav-link{color:rgba(255,255,255,.7);padding:12px 20px;border-radius:8px;margin:2px 12px;transition:.2s}
        .sidebar .nav-link:hover,.sidebar .nav-link.active{color:#fff;background:rgba(255,255,255,.1)}
        .sidebar .nav-link i{width:24px;text-align:center;margin-right:10px}
        .sidebar-brand{padding:20px;border-bottom:1px solid rgba(255,255,255,.1);margin-bottom:10px}
        .sidebar-brand h4{color:#fff;margin:0}.sidebar-brand small{color:rgba(255,255,255,.5)}
        .main-content{margin-left:260px;padding:30px}
        .stat-card{border:none;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.08);transition:.2s}
        .stat-card:hover{transform:translateY(-2px)}
        .stat-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem}
        .card{border:none;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
        .card-header{background:#fff;border-bottom:1px solid #e9ecef;border-radius:12px 12px 0 0!important}
        .table th{border-top:none;font-weight:600;color:#495057;font-size:.85rem;text-transform:uppercase}
        .btn{border-radius:8px}
        @media(max-width:768px){.sidebar{width:0;overflow:hidden}.main-content{margin-left:0}}
    </style>
</head>
<body>
<nav class="sidebar d-flex flex-column">
    <div class="sidebar-brand"><h4><i class="bi bi-heart-pulse"></i> MedRDV</h4><small>Gestion des rendez-vous</small></div>
    <ul class="nav flex-column flex-grow-1">
        <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' }}" href="{{ path('app_dashboard') }}"><i class="bi bi-speedometer2"></i> Tableau de bord</a></li>
        <li class="nav-item"><a class="nav-link {{ 'app_patient' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('app_patient_index') }}"><i class="bi bi-people"></i> Patients</a></li>
        <li class="nav-item"><a class="nav-link {{ 'app_medecin' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('app_medecin_index') }}"><i class="bi bi-person-badge"></i> Médecins</a></li>
        <li class="nav-item"><a class="nav-link {{ 'app_rendezvous' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('app_rendezvous_index') }}"><i class="bi bi-calendar-check"></i> Rendez-vous</a></li>
    </ul>
    <div class="p-3 border-top border-secondary"><small class="text-muted d-block text-center">MedRDV v1.0</small></div>
</nav>
<div class="main-content">
    {% for label, messages in app.flashes %}{% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show"><i class="bi bi-{{ label == 'success' ? 'check-circle' : 'info-circle' }}"></i> {{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}{% endfor %}
    {% block body %}{% endblock %}
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
