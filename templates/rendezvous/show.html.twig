{% extends 'base.html.twig' %}
{% block title %}RDV #{{ rdv.id }}{% endblock %}
{% block body %}
<nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_rendezvous_index') }}">Rendez-vous</a></li><li class="breadcrumb-item active">RDV #{{ rdv.id }}</li></ol></nav>
<div class="row g-4">
    <div class="col-lg-8"><div class="card">
        <div class="card-header py-3 d-flex justify-content-between align-items-center"><h4 class="mb-0"><i class="bi bi-calendar-check text-primary"></i> RDV #{{ rdv.id }}</h4><span class="badge {{ rdv.statutBadgeClass }} fs-6">{{ rdv.statutLabel }}</span></div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6"><div class="border rounded p-3"><h6 class="text-muted mb-3"><i class="bi bi-clock"></i> Informations</h6>
                    <table class="table table-borderless table-sm mb-0">
                        <tr><td class="text-muted" style="width:100px">Date</td><td><strong>{{ rdv.dateHeure|date('d/m/Y') }}</strong></td></tr>
                        <tr><td class="text-muted">Heure</td><td><strong>{{ rdv.dateHeure|date('H:i') }} - {{ rdv.dateFin|date('H:i') }}</strong></td></tr>
                        <tr><td class="text-muted">Durée</td><td>{{ rdv.dureeMinutes }} min</td></tr>
                        <tr><td class="text-muted">Créé le</td><td>{{ rdv.createdAt|date('d/m/Y H:i') }}</td></tr>
                        {% if rdv.updatedAt %}<tr><td class="text-muted">Modifié</td><td>{{ rdv.updatedAt|date('d/m/Y H:i') }}</td></tr>{% endif %}
                    </table>
                </div></div>
                <div class="col-md-6">
                    <div class="border rounded p-3 mb-3"><h6 class="text-muted mb-2"><i class="bi bi-person"></i> Patient</h6><a href="{{ path('app_patient_show', {id: rdv.patient.id}) }}"><strong>{{ rdv.patient.nomComplet }}</strong></a><br><small class="text-muted">{{ rdv.patient.telephone }}</small></div>
                    <div class="border rounded p-3"><h6 class="text-muted mb-2"><i class="bi bi-person-badge"></i> Médecin</h6><a href="{{ path('app_medecin_show', {id: rdv.medecin.id}) }}"><strong>{{ rdv.medecin.nomComplet }}</strong></a><br><small class="text-muted">{{ rdv.medecin.specialite }}</small></div>
                </div>
            </div>
            {% if rdv.motif %}<div class="mt-4"><h6 class="text-muted"><i class="bi bi-chat-text"></i> Motif</h6><p class="bg-light rounded p-3">{{ rdv.motif }}</p></div>{% endif %}
            {% if rdv.notes %}<div class="mt-3"><h6 class="text-muted"><i class="bi bi-journal-text"></i> Notes</h6><p class="bg-light rounded p-3">{{ rdv.notes }}</p></div>{% endif %}
        </div>
    </div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-header py-3"><h5 class="mb-0"><i class="bi bi-gear"></i> Actions</h5></div><div class="card-body d-grid gap-2">
            <a href="{{ path('app_rendezvous_edit', {id: rdv.id}) }}" class="btn btn-warning"><i class="bi bi-pencil"></i> Modifier</a>
            {% if rdv.statut == 'en_attente' %}
                <form method="post" action="{{ path('app_rendezvous_statut', {id: rdv.id, statut: 'confirme'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut' ~ rdv.id) }}"><button class="btn btn-success w-100"><i class="bi bi-check-circle"></i> Confirmer</button></form>
                <form method="post" action="{{ path('app_rendezvous_statut', {id: rdv.id, statut: 'annule'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut' ~ rdv.id) }}"><button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle"></i> Annuler</button></form>
            {% elseif rdv.statut == 'confirme' %}
                <form method="post" action="{{ path('app_rendezvous_statut', {id: rdv.id, statut: 'termine'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut' ~ rdv.id) }}"><button class="btn btn-secondary w-100"><i class="bi bi-check-all"></i> Terminé</button></form>
                <form method="post" action="{{ path('app_rendezvous_statut', {id: rdv.id, statut: 'annule'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut' ~ rdv.id) }}"><button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle"></i> Annuler</button></form>
            {% endif %}
            <hr>
            <form method="post" action="{{ path('app_rendezvous_delete', {id: rdv.id}) }}" onsubmit="return confirm('Supprimer ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rdv.id) }}"><button class="btn btn-outline-danger w-100"><i class="bi bi-trash"></i> Supprimer</button></form>
        </div></div>
        <a href="{{ path('app_rendezvous_index') }}" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>
</div>
{% endblock %}
