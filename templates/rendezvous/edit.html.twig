{% extends 'base.html.twig' %}
{% block title %}Modifier RDV #{{ rdv.id }}{% endblock %}
{% block body %}
<nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_rendezvous_index') }}">Rendez-vous</a></li><li class="breadcrumb-item"><a href="{{ path('app_rendezvous_show', {id: rdv.id}) }}">RDV #{{ rdv.id }}</a></li><li class="breadcrumb-item active">Modifier</li></ol></nav>
<div class="row justify-content-center"><div class="col-lg-8"><div class="card">
    <div class="card-header py-3"><h4 class="mb-0"><i class="bi bi-pencil text-warning"></i> Modifier le rendez-vous</h4></div>
    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="row"><div class="col-md-6 mb-3">{{ form_row(form.patient) }}</div><div class="col-md-6 mb-3">{{ form_row(form.medecin) }}</div></div>
        <div class="row"><div class="col-md-4 mb-3">{{ form_row(form.dateHeure) }}</div><div class="col-md-4 mb-3">{{ form_row(form.dureeMinutes) }}</div><div class="col-md-4 mb-3">{{ form_row(form.statut) }}</div></div>
        <div class="mb-3">{{ form_row(form.motif) }}</div>
        <div class="mb-3">{{ form_row(form.notes) }}</div>
        <div class="d-flex justify-content-between"><a href="{{ path('app_rendezvous_show', {id: rdv.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a><button type="submit" class="btn btn-warning"><i class="bi bi-check-lg"></i> Enregistrer</button></div>
        {{ form_end(form) }}
    </div>
</div></div></div>
{% endblock %}
